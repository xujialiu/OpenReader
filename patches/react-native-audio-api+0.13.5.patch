+  if (drained) {
+    outputPosition_ = finishAt_;
+    outputStretcher_.reset();
+    outputOrigin_ = finishAt_;
+    finishing_ = false;
+  }
+  dispatchOutputEnds(drained);
+  if (isPlaying()) reportOutputPosition(frames);
+}
