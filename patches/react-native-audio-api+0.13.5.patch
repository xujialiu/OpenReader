+size_t WsolaTimeStretcher::pull(
+    DSPAudioBuffer &input, DSPAudioBuffer &output, size_t frames,
+    float rate, float pitchFactor, const std::function<size_t(size_t)> &supply) {
+  output.zero();
+  pitchFactor_ = pitchFactor > 0.0f ? pitchFactor : 1.0f;
+  if (channels_ == 0 || frames == 0 || rate <= 0.0f || input.getSize() == 0) return 0;
+  size_t rendered = 0;
+  while (rendered < frames) {
+    rendered += writeOutput(output, rendered, frames - rendered);
+    if (rendered == frames) break;
+    while (!canRunIteration()) {
+      const int searchSize = static_cast<int>(searchIntervalFrames_ + windowSize_ - 1);
+      const int last = std::max(maxSourceIndexForBlock(targetBlockIndex_),
+          maxSourceIndexForBlock(searchBlockIndex_ + searchSize - 1));
+      const size_t needed = static_cast<size_t>(std::max(0, last + 1 - static_cast<int>(inputQueue_[0].size())));
+      const size_t supplied = supply(std::min(needed, input.getSize()));
+      if (supplied == 0) return rendered;
+      appendInput(input, supplied);
+    }
+    if (!runOneIteration(rate)) break;
+  }
+  return rendered;
+}
+
+bool WsolaTimeStretcher::hasSourceBefore(double frame) const {
+  const double next = inputOrigin_ + std::min(targetBlockIndex_, searchBlockIndex_) * static_cast<double>(pitchFactor_);
+  if (next < frame) return true;
+  for (size_t i = outputReadIndex_; i < lowerQueue_.size(); ++i) if (lowerQueue_[i] < frame) return true;
+  if (haveOverlapPosition_) for (double lower : overlapLower_) if (lower < frame) return true;
+  return false;
+}
