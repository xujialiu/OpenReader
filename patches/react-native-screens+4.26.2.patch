+// OpenReader (#332): capture and restore in the coordinate system UIKit
+// actually displays. RN's scroll event exposes only the explicit contentInset,
+// and its scrollTo command clamps negative offsets against that same inset.
+- (UIScrollView *)openReaderScrollView
+{
+#if !TARGET_OS_TV
+  if (self.owningScreen.navigationItem.searchController == _controller) {
+    return [self.owningScreen contentScrollViewForEdge:NSDirectionalRectEdgeTop];
+  }
+#endif
+  return nil;
+}
+
+- (void)captureScrollPosition:(NSString *)slot
+{
+  UIScrollView *scroll = [self openReaderScrollView];
+  if (scroll == nil) {
+    return;
+  }
+  CGFloat logical = MAX(0, scroll.contentOffset.y + scroll.adjustedContentInset.top);
+  if ([slot isEqualToString:@"browse"] && !_hasBrowseScrollPosition) {
+    _browseScrollPosition = logical;
+    _hasBrowseScrollPosition = YES;
+  } else if ([slot isEqualToString:@"results"]) {
+    _resultScrollPosition = logical;
+  }
+}
+
+- (void)restoreScrollPosition:(NSString *)slot
+{
+  UIScrollView *scroll = [self openReaderScrollView];
+  if (scroll == nil) {
+    return;
+  }
+  CGFloat logical;
+  if ([slot isEqualToString:@"browse"]) {
+    logical = _browseScrollPosition;
+  } else if ([slot isEqualToString:@"results"]) {
+    logical = _resultScrollPosition;
+  } else if ([slot isEqualToString:@"top"]) {
+    logical = 0;
+  } else {
+    return;
+  }
+  UIEdgeInsets inset = scroll.adjustedContentInset;
+  CGFloat last = MAX(0, scroll.contentSize.height + inset.top + inset.bottom - CGRectGetHeight(scroll.bounds));
+  CGPoint offset = scroll.contentOffset;
+  offset.y = MIN(logical, last) - inset.top;
+  [scroll setContentOffset:offset animated:NO];
+}
