# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Provider API keys, copied from the Zotero-TTS plugin's settings for testing.
# Never committed: PHILOSOPHY rule 3 says a key goes to the provider it belongs
# to and nowhere else, and a key in git history has gone somewhere else forever.
/.secrets
__pycache__/

# Local automation configuration and artifacts
/.playwright-mcp/
/.mobilebuildmcp/

# Sub-worktrees an agent creates for other agents (AGENTS.md, "Sub-worktrees")
/.worktrees/

# App Store screenshots and the script that resizes them; local only
/.screenshots/

# The README as GitHub renders it, built for the owner to look at
# (scripts/readme-preview.sh, MEMORY/documentation.md)
/.docs/
