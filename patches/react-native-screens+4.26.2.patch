     // change wasn't on the top of the stack. We don't need animation.
     [_controller setViewControllers:controllers animated:NO];
+    [self openReaderNameControllersBelowTop:controllers];
+    [self openReaderConfigureTop:top];
   }
+  [self openReaderNameControllersBelowTop:controllers];
 }
 
