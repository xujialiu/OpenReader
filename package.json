{
  "name": "openreader",
  "version": "1.0.4",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "EXPO_PUBLIC_OPENREADER_VARIANT=debug expo start",
    "android": "expo run:android",
    "ios": "EXPO_PUBLIC_OPENREADER_VARIANT=debug expo run:ios",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "postinstall": "patch-package",
    "acknowledgements": "node scripts/acknowledgements/generate.mjs"
  },
  "dependencies": {
    "@epubjs-react-native/core": "^1.4.8",
    "@expo/ui": "~58.0.27",
    "@react-navigation/elements": "^2.9.43",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@xmldom/xmldom": "^0.9.12",
    "expo": "~58.0.23",
    "expo-clipboard": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "fflate": "^0.8.3",
    "htmlparser2": "^10.1.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-audio-api": "0.13.5",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-teleport": "1.2.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "sentencex": "^0.4.2",
    "unicode-segmenter": "^0.17.3"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "expo-mcp": "~0.2.1",
    "patch-package": "^8.0.1",
    "react-dom": "19.3.0",
    "react-test-renderer": "19.3.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "react-dom": "$react"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "expo"
        ]
      }
    }
  }
}
