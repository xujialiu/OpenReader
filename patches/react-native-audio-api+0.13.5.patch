+void AudioBufferQueueSourceNode::initStretch(
+    size_t channels, float sampleRate, const std::shared_ptr<DSPAudioBuffer> &scratch) {
+  if (!outputDriven_) {
+    AudioBufferBaseSourceNode::initStretch(channels, sampleRate, scratch);
+    return;
+  }
+  outputStretcher_.configure(channels, sampleRate);
+  pullInput_ = std::make_shared<DSPAudioBuffer>(4096, channels, sampleRate);
+}
+
+double AudioBufferQueueSourceNode::inputPosition() const {
+  return vReadIndex_ / getContextSampleRate() + playedBuffersDuration_;
+}
+
+void AudioBufferQueueSourceNode::rebuildFromOutput() {
+  const double offset = replacedFront_ ? 0.0 : std::max(0.0, outputPosition_ - emittedDuration_);
+  buffers_ = outputBuffers_;
+  playedBuffersDuration_ = emittedDuration_;
+  vReadIndex_ = offset * getContextSampleRate();
+  outputOrigin_ = outputPosition_ = emittedDuration_ + offset;
+  outputEnds_.clear(); outputStretcher_.reset();
+  finishing_ = rebuildOutput_ = replacedFront_ = false;
+}
+
+void AudioBufferQueueSourceNode::dispatchOutputEnds(bool drained) {
+  while (!outputEnds_.empty()) {
+    const auto event = outputEnds_.front();
+    if (event.end > outputPosition_ + 1e-9 || (event.last && !drained)) break;
+    outputEnds_.pop_front();
+    emittedDuration_ = event.end;
+    if (!outputBuffers_.empty() && outputBuffers_.front().first == event.id) {
+      if (auto context = context_.lock()) context->getGraphManager()->addAudioBufferForDestruction(std::move(outputBuffers_.front().second));
+      outputBuffers_.pop_front();
+    }
+    sendOnBufferEndedEvent(event.id, event.last && outputBuffers_.empty());
+  }
+}
+
+void AudioBufferQueueSourceNode::processWithPitchCorrection(
+    const std::shared_ptr<DSPAudioBuffer> &output, int frames) {
+  auto context = context_.lock();
+  if (!context || !pullInput_) { output->zero(); return; }
+  if (rebuildOutput_) rebuildFromOutput();
+  const double time = context->getCurrentTime();
+  const float rate = std::clamp(getPlaybackRateParam()->processKRateParam(frames, time),
+      0.0f, WsolaTimeStretcher::MAX_PLAYBACK_RATE);
+  size_t start = 0, length = 0;
+  updatePlaybackInfo(output, frames, start, length, context->getSampleRate(), context->getCurrentSampleFrame());
+  if (length == 0 || rate == 0.0f || (!isPlaying() && !isStopScheduled())) { output->zero(); return; }
+  const float pitch = std::pow(2.0f, getDetuneParam()->processKRateParam(frames, time) / 1200.0f);
+  outputStretcher_.pull(*pullInput_, *output, length, rate, pitch, [this](size_t needed) {
+    pullInput_->zero();
+    if (finishing_) return needed; // padding is not part of the content clock
+    if (buffers_.empty()) return size_t(0);
+    const double before = inputPosition();
+    runBufferProcessor(pullInput_, 0, needed, 1.0f, false);
+    return static_cast<size_t>(std::llround((inputPosition() - before) * getContextSampleRate()));
+  });
+  if (start > 0) {
+    for (size_t channel = 0; channel < output->getNumberOfChannels(); ++channel) {
+      auto *samples = output->getChannel(channel)->begin();
+      std::memmove(samples + start, samples, length * sizeof(float));
+      std::fill_n(samples, start, 0.0f);
+    }
+  }
