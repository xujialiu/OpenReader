 #pragma mark - RNSScreen
 
+#if !TARGET_OS_TV
+// OpenReader (#339): a Library or Folder page holds a key target, a view of the
+// app's own (modules/open-reader-library-keys) that says which of its commands
+// apply now and hands a pressed one to the page's JavaScript. The page only
+// scopes them; it knows nothing else about Library Search.
+@protocol RNSOpenReaderLibraryKeyTarget <NSObject>
+- (NSArray<NSString *> *)openReaderLibraryKeys;
+- (void)openReaderPerformLibraryKey:(NSString *)key;
+@end
+#endif
+
 @implementation RNSScreen {
   __weak id _previousFirstResponder;
+#if !TARGET_OS_TV
+  __weak UIView *_openReaderLibraryKeyTarget;
+#endif
   CGRect _lastViewFrame;
   UIView *_fakeView;
   CADisplayLink *_animationTimer;
@@ -1481,6 +1495,100 @@ - (instancetype)initWithView:(UIView *)view
   return self;
 }
 
+#if !TARGET_OS_TV
+// OpenReader (#332, #339): Library commands belong to the top page alone, in a
+// window, with nothing presented over it (an actions drawer, an alert), so the
+// Reader, Settings and a modal never receive them. Never process-wide.
+- (nullable id<RNSOpenReaderLibraryKeyTarget>)openReaderLibraryKeyTarget
+{
+  if (self.navigationController.topViewController != self || self.view.window == nil) {
+    return nil;
+  }
+  for (UIViewController *page = self; page != nil; page = page.parentViewController) {
+    if (page.presentedViewController != nil) {
+      return nil;
+    }
+  }
+  UIView *cached = _openReaderLibraryKeyTarget;
+  if (cached != nil && [cached isDescendantOfView:self.view]) {
+    return (id<RNSOpenReaderLibraryKeyTarget>)cached;
+  }
+  NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:self.view];
+  for (NSUInteger i = 0; i < queue.count; i++) {
+    UIView *view = queue[i];
+    if ([view respondsToSelector:@selector(openReaderLibraryKeys)] &&
+        [view respondsToSelector:@selector(openReaderPerformLibraryKey:)]) {
+      _openReaderLibraryKeyTarget = view;
+      return (id<RNSOpenReaderLibraryKeyTarget>)view;
+    }
+    [queue addObjectsFromArray:view.subviews];
+  }
+  return nil;
+}
+
+// Escape and Command-F belong first to a text being composed in the page's
+// search field (marked text, as Bopomofo leaves it), so neither is offered then.
+- (BOOL)openReaderComposingText
+{
+  NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:self.view];
+  for (NSUInteger i = 0; i < queue.count; i++) {
+    UIView *view = queue[i];
+    if (view.isFirstResponder) {
+      return [view conformsToProtocol:@protocol(UITextInput)] && ((id<UITextInput>)view).markedTextRange != nil;
+    }
+    [queue addObjectsFromArray:view.subviews];
+  }
+  return NO;
+}
+
+- (NSArray<UIKeyCommand *> *)openReaderLibraryKeyCommands
+{
+  id<RNSOpenReaderLibraryKeyTarget> target = [self openReaderLibraryKeyTarget];
+  NSArray<NSString *> *keys = target != nil ? [target openReaderLibraryKeys] : @[];
+  if (keys.count == 0 || [self openReaderComposingText]) {
+    return @[];
+  }
+  NSMutableArray<UIKeyCommand *> *commands = [NSMutableArray array];
+  if ([keys containsObject:@"find"]) {
+    UIKeyCommand *find = [UIKeyCommand keyCommandWithInput:@"f"
+                                          modifierFlags:UIKeyModifierCommand
+                                                 action:@selector(openReaderFindInLibrary:)];
+    find.discoverabilityTitle = @"Search Library";
+    [commands addObject:find];
+  }
+  if ([keys containsObject:@"escape"]) {
+    UIKeyCommand *escape = [UIKeyCommand keyCommandWithInput:UIKeyInputEscape
+                                            modifierFlags:0
+                                                   action:@selector(openReaderEscapeInLibrary:)];
+    escape.discoverabilityTitle = @"Cancel";
+    escape.wantsPriorityOverSystemBehavior = YES;
+    [commands addObject:escape];
+  }
+  return commands;
+}
+
+// Checked again when pressed: UIKit may have cached the commands before the
+// page changed, or before composition began.
+- (void)openReaderSendLibraryKey:(NSString *)key
+{
+  id<RNSOpenReaderLibraryKeyTarget> target = [self openReaderLibraryKeyTarget];
+  if (target == nil || ![[target openReaderLibraryKeys] containsObject:key] || [self openReaderComposingText]) {
+    return;
+  }
+  [target openReaderPerformLibraryKey:key];
+}
+
+- (void)openReaderFindInLibrary:(UIKeyCommand *)command
+{
+  [self openReaderSendLibraryKey:@"find"];
+}
+
+- (void)openReaderEscapeInLibrary:(UIKeyCommand *)command
+{
+  [self openReaderSendLibraryKey:@"escape"];
+}
+#endif
+
